            random_state=42,
            num_configs_saved=1,
            cuda_visible_devices="-1",
        )
    
        # Assertions for global settings
        assert global_settings.verbosity == 1
        assert global_settings.random_state == 42
        assert global_settings.num_configs_saved == 1
    
